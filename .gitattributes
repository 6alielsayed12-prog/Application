# Default line endings
* text=auto

# Windows batch, PowerShell, and Inno Setup scripts MUST use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Python, shell, web, and docs use LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
